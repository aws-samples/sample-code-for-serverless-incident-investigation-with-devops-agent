{
  "services": {
    "order-processing-service": {
      "description": "Handles order creation, retrieval, and lifecycle management",
      "dependencies": ["payment-validation-service"],
      "aws_resources": {
        "ecs_cluster": "platform-services-cluster",
        "ecs_service": "order-processing-service",
        "log_group": "/ecs/order-processing-service",
        "dynamodb_table": "order-records",
        "alb": "order-processing-alb",
        "alarms": [
          "order-processing-error-rate-high",
          "order-processing-latency-p99-high"
        ]
      },
      "escalation": "platform-engineering-oncall"
    },
    "payment-validation-service": {
      "description": "Validates payment details before order creation",
      "dependents": ["order-processing-service"],
      "aws_resources": {
        "lambda_function": "payment-validation-service",
        "log_group": "/aws/lambda/payment-validation-service",
        "dynamodb_table": "payment-records"
      },
      "escalation": "payments-team-oncall"
    }
  }
}
